#!/usr/bin/env bash
set -euo pipefail

base=${1:?usage: scripts/check-changelog <base> <head>}
head=${2:?usage: scripts/check-changelog <base> <head>}

needs=$(git log --format=%s "$base..$head" | grep -E '^(feat|fix|perf)(\(|!|:)' | grep -vF '[skip changelog]' || true)
[[ -z $needs ]] && exit 0

if git diff --name-only "$base...$head" | grep -qx CHANGELOG.md; then
  exit 0
fi

echo "These commits change what people see, but CHANGELOG.md has no new lines under [Unreleased]:" >&2
sed 's/^/  /' <<<"$needs" >&2
echo "Add the lines, label the PR no-changelog, or put [skip changelog] in a commit subject." >&2
exit 1
